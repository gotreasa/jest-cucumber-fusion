{
  "name": "@g_package/jest-cucumber-fusion",
  "version": "0.0.0-semantically-released",
  "description": "Write cucumber test as part of a jest run (including coverage)",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "jest --color",
    "test-d": "tsd",
    "test:baseline": "node test/specs/baseline/run-all.js",
    "coverage": "jest --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:secrets": "secretlint \"**/*\"",
    "commit": "git-cz",
    "semantic-release": "semantic-release",
    "fmt": "npx prettier --write .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gotreasa/jest-cucumber-fusion.git"
  },
  "keywords": [
    "jest",
    "cucumber",
    "BDD",
    "gherkin"
  ],
  "dependencies": {
    "@cucumber/gherkin": "39.1.0",
    "@cucumber/messages": "32.3.1",
    "@cucumber/tag-expressions": "9.1.0",
    "callsites": "~3.1.0",
    "jest": "^30.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@secretlint/secretlint-rule-pattern": "^13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.16.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "2.3.2",
    "secretlint": "^13.0.7",
    "semantic-release": "^25.0.5",
    "tsd": "^0.33.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": true
        }
      ]
    ],
    "parserOpts": {
      "mergePattern": "Merged PR .*:"
    }
  },
  "author": "B-Yond",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/gotreasa/jest-cucumber-fusion/issues"
  },
  "homepage": "https://github.com/gotreasa/jest-cucumber-fusion#readme",
  "jest": {
    "testMatch": [
      "**/*.steps.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ],
    "coverageDirectory": "./coverage/",
    "collectCoverage": true
  }
}
