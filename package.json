{
  "name": "@g_package/jest-cucumber-fusion",
  "version": "0.0.0-semantically-released",
  "description": "Write cucumber test as part of a jest run (including coverage)",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "src/index.d.ts",
  "files": [
    "src/",
    "dist/",
    "scripts/prepare-hooks.js"
  ],
  "engines": {
    "node": "^18.14.0 || ^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "pretest": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --color",
    "test-d": "tsd",
    "test:baseline": "node test/specs/baseline/run-all.js",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:secrets": "secretlint \"**/*\"",
    "commit": "czg",
    "semantic-release": "semantic-release",
    "fmt": "npx prettier --write .",
    "prepare": "node scripts/prepare-hooks.js",
    "build": "node scripts/build-cjs.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p jsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gotreasa/jest-cucumber-fusion.git"
  },
  "keywords": [
    "jest",
    "cucumber",
    "BDD",
    "gherkin"
  ],
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "@cucumber/tag-expressions": "11.0.1",
    "callsites": "4.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-pattern": "^13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/jest": "^30.0.0",
    "czg": "1.14.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jest": "^29.16.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "secretlint": "^13.0.7",
    "semantic-release": "^25.0.5",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": false,
          "tarballDir": "release"
        }
      ]
    ],
    "parserOpts": {
      "mergePattern": "Merged PR .*:"
    }
  },
  "author": "B-Yond",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/gotreasa/jest-cucumber-fusion/issues"
  },
  "homepage": "https://github.com/gotreasa/jest-cucumber-fusion#readme",
  "jest": {
    "testMatch": [
      "**/*.steps.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ],
    "coverageDirectory": "./coverage/",
    "collectCoverage": true
  },
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "jest": ">=27"
  }
}
